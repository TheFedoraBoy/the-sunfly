# Variables to set on the Railway web service (Variables tab).
# Locally you need none of these: the app falls back to SQLite and DEBUG on.

SECRET_KEY=paste-a-long-random-string-here
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Creates your newsroom login on first deploy. Change the password after
# logging in, then you can delete ADMIN_PASSWORD from Railway.
ADMIN_USERNAME=zachary
ADMIN_PASSWORD=choose-a-strong-password

# Where uploaded photos are stored. Must sit inside the Railway Volume.
MEDIA_ROOT=/data/media

# Only when you add your own domain (comma separated, no https://):
# ALLOWED_HOSTS=thesunfly.com,www.thesunfly.com

# Optional. Defaults to America/New_York; decides when "today" rolls over.
# TIME_ZONE=America/New_York
